# Variables pour le serveur HTTP Triskell Command (run_http.py)
# Copier en .env (à la racine du projet) et remplir.
# .env est ignoré par git — JAMAIS commit ces secrets.

# Clé secrète pour signer les cookies de session. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si non définie, une clé éphémère est générée à chaque démarrage
# (= toutes les sessions sont perdues à chaque restart). À éviter en prod.
SESSION_SECRET=

# Hash bcrypt des mots de passe Jordan / Thomas. Générer avec :
#   python scripts/hash_password.py
JORDAN_PASSWORD_HASH=
THOMAS_PASSWORD_HASH=
